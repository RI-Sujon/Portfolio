<!-- Home / Hero Section -->
<section id="home" class="hero section vh-100">
    <!-- Animated Background Grid -->
    <div class="hero-grid"></div>

    <!-- Floating Orbs Background -->
    <div class="hero-orb orb-1"></div>
    <div class="hero-orb orb-2"></div>
    <div class="hero-orb orb-3"></div>
    <div class="hero-orb orb-4"></div>

    <!-- Particles Container -->
    <div class="particles"></div>

    <!-- Floating Code Snippets -->
    <div class="floating-code code-1">&lt;Developer /&gt;</div>
    <div class="floating-code code-2">{ creative: true }</div>
    <div class="floating-code code-3">async () =&gt; success</div>

    <div class="hero-container">
        <!-- Left Content -->
        <div class="hero-content">
            <br /><br />
            <!-- Status Badge -->
            <div class="hero-status animate-fade-up">
                <span class="status-dot"></span>
                <span>Available for opportunities</span>
            </div>

            <p class="hero-greeting animate-fade-up delay-1">
                <span class="wave-emoji">👋</span> Hello, I'm
            </p>

            <!-- Name with Gradient -->
            <h1 class="hero-name animate-fade-up delay-1">
                <span class="text-gradient">Rabiul Islam</span>
                <span class="name-highlight">Sujon</span>
            </h1>

            <!-- Role with Typing Effect -->
            <div class="hero-role animate-fade-up delay-2">
                <span class="role-prefix">I'm a</span>
                <span class="role-text">
                    <span class="typing-dynamic">Full-Stack Developer</span>
                    <span class="typing-cursor">|</span>
                </span>
            </div>

            <!-- Experience Stats -->
            <div class="hero-stats animate-fade-up delay-2">
                <div class="stat-item">
                    <span class="stat-number">4.5+</span>
                    <span class="stat-label">Years Exp.</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                    <span class="stat-number">20+</span>
                    <span class="stat-label">Projects</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                    <span class="stat-number">6+</span>
                    <span class="stat-label">Tech Stack</span>
                </div>
            </div>

            <!-- Tech Stack Icons -->
            <div class="hero-tech-icons animate-fade-up delay-3">
                <div class="tech-icon-wrapper" title="C#">
                    <div class="tech-icon csharp">
                        <i class="devicon-csharp-plain"></i>
                    </div>
                </div>
                <div class="tech-icon-wrapper" title="React">
                    <div class="tech-icon react">
                        <i class="devicon-react-original"></i>
                    </div>
                </div>
                <div class="tech-icon-wrapper" title="Flutter">
                    <div class="tech-icon flutter">
                        <i class="devicon-flutter-plain"></i>
                    </div>
                </div>
                <div class="tech-icon-wrapper" title="Azure SQL">
                    <div class="tech-icon azuresql">
                        <i class="devicon-azuresqldatabase-plain"></i>
                    </div>
                </div>
                <div class="tech-icon-wrapper" title="Azure">
                    <div class="tech-icon azure">
                        <i class="devicon-azure-plain"></i>
                    </div>
                </div>
            </div>

            <!-- Social Links - Clean Style -->
            <div class="hero-social-clean animate-fade-up delay-4">
                <a href="https://github.com/RI-Sujon" target="_blank" title="GitHub" class="social-link-clean">
                    <i class="bi bi-github"></i>
                </a>
                <a href="https://www.linkedin.com/in/ri-sujon-58b63618a/" target="_blank" title="LinkedIn" class="social-link-clean">
                    <i class="bi bi-linkedin"></i>
                </a>
                <a href="mailto:s.rabiulislam429@gmail.com" title="Email" class="social-link-clean">
                    <i class="bi bi-envelope-fill"></i>
                </a>
            </div>
        </div>

        <!-- Right - Full Body Image -->
        <div class="hero-image-section animate-scale">
            <!-- Decorative Elements -->
            <div class="image-decoration deco-circle-1"></div>
            <div class="image-decoration deco-circle-2"></div>
            <div class="image-decoration deco-dots"></div>

            <!-- Orbiting Icons -->
            <div class="orbiting-icons">
                <div class="orbit-icon orbit-1"><i class="bi bi-code-slash"></i></div>
                <div class="orbit-icon orbit-2"><i class="bi bi-braces"></i></div>
                <div class="orbit-icon orbit-3"><i class="bi bi-terminal"></i></div>
            </div>

            <!-- Main Image Container -->
            <div class="hero-image-wrapper">
                <div class="hero-image-glow"></div>
                <div class="hero-image-frame">
                    <img src="images/full_pic.jpg" class="hero-full-image" alt="Rabiul Islam" />
                </div>
                <div class="hero-image-border"></div>
            </div>

            <!-- Experience Badge -->
            <div class="experience-badge">
                <span class="exp-number">4.5+</span>
                <span class="exp-text">Years Experience</span>
            </div>

            <!-- Location Tag -->
            <div class="location-tag">
                <i class="bi bi-geo-alt-fill"></i>
                <span>Dhaka, Bangladesh</span>
            </div>
        </div>
    </div>

    <!-- Mouse Scroll Indicator inside hero -->
    <div class="hero-scroll-hint">
        <div class="mouse">
            <div class="mouse-wheel"></div>
        </div>
        <span>Scroll to explore</span>
    </div>
</section>
