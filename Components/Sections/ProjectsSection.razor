<!-- Projects Section -->
<section id="projects" class="container section">
    <div class="section-header animate-fade-up">
        <span class="section-label">What I've built</span>
        <h2 class="section-title-new">Projects</h2>
    </div>

    <!-- Professional Projects -->
    <div class="projects-subsection mb-5 animate-fade-up delay-1">
        <h4 class="subsection-title"><i class="bi bi-briefcase me-2"></i>Professional Projects</h4>
        <p class="subsection-desc text-secondary mb-4">Company projects with limited public details due to confidentiality.</p>
        <div class="pro-projects-grid">
            @foreach (var p in PortfolioData.ProProjects)
            {
                <div class="pro-project-card">
                    <div class="pro-card-header">
                        <div class="pro-company-badge">
                            @if (!string.IsNullOrEmpty(p.CompanyLogo))
                            {
                                <img src="images/@(p.CompanyLogo)" alt="@p.Company" class="pro-company-logo" />
                            }
                            else
                            {
                                <span class="pro-company-logo pro-company-logo-fallback"><i class="bi bi-briefcase-fill"></i></span>
                            }
                            <span class="pro-company-name">@p.Company</span>
                        </div>
                        <span class="confidential-badge" title="Limited public details due to confidentiality">
                            <i class="bi bi-lock-fill"></i>
                        </span>
                    </div>
                    <h5 class="pro-project-title">@p.Title</h5>
                    <div class="pro-tech-stack">
                        @foreach (var tech in p.Tech.Split(", "))
                        {
                            <span class="tech-badge-sm">@tech</span>
                        }
                    </div>
                    <p class="pro-project-desc">@p.Desc</p>
                    @if (p.Responsibilities.Length > 0)
                    {
                        <details class="pro-contributions">
                            <summary class="pro-contributions-label">
                                <span><i class="bi bi-check2-circle me-1"></i>Key Contributions</span>
                                <i class="bi bi-chevron-down pro-contributions-chevron"></i>
                            </summary>
                            <ul class="pro-project-responsibilities">
                                @foreach (var r in p.Responsibilities)
                                {
                                    <li>@r</li>
                                }
                            </ul>
                        </details>
                    }
                </div>
            }
        </div>
    </div>

</section>
